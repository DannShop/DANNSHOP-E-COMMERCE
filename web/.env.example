DATABASE_URL="mysql://root:@127.0.0.1:3306/dannshop_next"
AUTH_SECRET="ganti-dengan-random-hex-32-byte"
ADMIN_EMAIL="admin@dannshop.test"
ADMIN_PASSWORD="ganti-password-kuat"
CREDENTIALS_ENCRYPTION_KEY="isi-64-hex-char-hasil: openssl rand -hex 32"
CRON_SECRET="isi-string-acak-panjang"
MIDTRANS_SERVER_KEY="isi-server-key-sandbox-dari-dashboard-midtrans"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TELEGRAM_BOT_TOKEN="isi-token-bot-dari-botfather"
TELEGRAM_CHAT_ID="isi-chat-id-tujuan-notifikasi"
# NEXT_PUBLIC_WHATSAPP_CS / NEXT_PUBLIC_TELEGRAM_CS: fallback saja - sumber
# utama sekarang Admin > Pengaturan Situs > Kontak CS (tersimpan di DB).
# Cuma dipakai kalau admin belum pernah menyimpan lewat form itu.
NEXT_PUBLIC_WHATSAPP_CS="isi-nomor-format-62xxx-tanpa-plus-untuk-tombol-support-customer"
NEXT_PUBLIC_TELEGRAM_CS="isi-username-telegram-tanpa-@-untuk-tombol-support-customer"
BLOB_READ_WRITE_TOKEN="isi-token-dari-vercel-blob-store-untuk-upload-banner-produk"
# Relay ber-IP tetap untuk panggilan ke Digiflazz. Digiflazz cuma melayani IP yang
# terdaftar di whitelist mereka, sementara IP keluar Vercel berganti tiap invocation
# (rc 45: "IP Anda tidak kami kenali"). Isi KEDUANYA untuk mengaktifkan; kalau salah
# satu kosong, panggilan keluar langsung seperti sebelumnya - itu yang dipakai saat
# development lokal. Panduan pemasangan: docs/08-IP-TETAP-DIGIFLAZZ.md
PROVIDER_RELAY_URL=""
PROVIDER_RELAY_SECRET=""
# RESEND_API_KEY / RESEND_FROM_EMAIL sudah TIDAK dipakai lagi - konfigurasi
# email (Resend atau SMTP) sekarang sepenuhnya lewat Admin > Pengaturan Situs
# > Pengiriman Email, tersimpan terenkripsi di database (butuh
# CREDENTIALS_ENCRYPTION_KEY di atas, bukan env var terpisah).
