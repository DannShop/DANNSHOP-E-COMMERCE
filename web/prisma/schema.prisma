generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum Role {
  USER
  ADMIN
  /// Karyawan panel. Boleh masuk /admin, tapi HANYA sejauh izin di StaffRole-nya.
  STAFF
}

/// Peran karyawan yang dibuat sendiri oleh pemilik toko.
///
/// Yang bisa dikarang admin adalah PERAN-nya (nama + kumpulan izin); daftar
/// izin yang bisa dipilih DIDEFINISIKAN DI KODE (lib/rbac/permissions.ts),
/// karena tiap izin harus benar-benar diperiksa oleh sesuatu - izin yang cuma
/// bisa dicentang tapi tidak pernah dicek adalah pagar bohongan.
///
/// `permissions` disimpan sebagai JSON array string, BUKAN tabel join. Pola yang
/// sama dipakai MembershipTier.benefits, dengan alasan sama: katalognya kecil,
/// tertutup, dan ditentukan kode - tabel join di sini cuma menambah kerumitan
/// tanpa satu pun pertanyaan baru yang bisa dijawabnya.
///
/// Menghapus peran TIDAK menghapus karyawannya: relasinya opsional, jadi user
/// yang perannya dihapus kehilangan seluruh izin (jatuh ke nol) alih-alih ikut
/// terhapus bersama akunnya.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  /// Array key izin. Disaring ulang saat dibaca oleh parsePermissions().
  permissions Json
  /// Peran nonaktif tidak bisa dipasang ke karyawan baru; yang sudah memakainya
  /// TETAP kehilangan izinnya seketika - lihat resolveViewer di lib/auth/admin-gate.ts.
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ProviderKey {
  DIGIFLAZZ
  OKECONNECT
  QIOSPAY
  SERPUL
}

enum ProviderSkuStatus {
  ACTIVE
  UNAVAILABLE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  EXPIRED
  FAILED
  REFUND_PENDING
  REFUNDED
  NEEDS_REVIEW
}

enum PaidVia {
  MIDTRANS
  BALANCE
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum FulfillmentStatus {
  SENT
  PROCESSING
  SUCCESS
  FAILED
}

// Cara sebuah produk dipenuhi setelah pembayaran diterima.
//
// AUTO   = dikirim otomatis ke provider (Digiflazz dkk) - perilaku lama, tetap default.
// MANUAL = tidak ada provider yang bisa mengirimkannya (mis. akun aplikasi premium);
//          uang tetap ditagih & diterima lewat jalur normal, tapi barangnya
//          dikirim admin sendiri lalu diselesaikan lewat "Tandai Selesai Manual".
//
// Sengaja BUKAN nilai baru di OrderStatus: order manual melewati rangkaian
// status yang sama persis (PAID -> PROCESSING -> COMPLETED), yang berbeda cuma
// SIAPA yang menuntaskannya. Menambah status baru berarti menyentuh setiap
// switch/label/filter status yang sudah ada tanpa memberi informasi tambahan.
enum FulfillmentMode {
  AUTO
  MANUAL
}

enum LedgerType {
  DEPOSIT
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
  MEMBERSHIP // pembelian paket tier pakai saldo
}

enum DepositStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

enum BalanceAlertStatus {
  OK
  LOW
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ===== Blok 3: User & Wallet =====

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  // Suspend akun. null = normal. Sengaja timestamp, bukan Boolean: "kapan
  // di-banned" ikut terekam tanpa kolom tambahan (pola sama dengan
  // emailVerifiedAt di atas & PasswordResetToken.usedAt).
  //
  // PENTING - kolom ini TIDAK cukup dibaca saat login saja. JWT di
  // lib/auth.config.ts stateless dengan maxAge 8 jam, jadi sesi yang sudah
  // terlanjur terbit tetap hidup setelah admin nge-ban. Semua jalur uang wajib
  // lewat assertUserNotBanned() di lib/account/user-status.ts.
  bannedAt        DateTime?
  banReason       String?   @db.Text

  // ===== Autentikasi dua faktor (TOTP) =====
  // Rahasianya DIENKRIPSI (lib/crypto.ts), bukan di-hash: verifikasi TOTP butuh
  // rahasia aslinya untuk menghitung ulang kode tiap 30 detik - sama seperti
  // PartnerAccount.apiKeyEnc yang butuh key asli untuk menandatangani. Kalau
  // bisa di-hash, sudah pasti di-hash.
  //
  // `totpEnabledAt` yang menentukan aktif/tidak, BUKAN ada/tidaknya rahasia:
  // rahasia sudah ditulis begitu QR ditampilkan, tapi 2FA belum boleh berlaku
  // sampai orangnya membuktikan aplikasinya benar-benar terpasang dengan
  // memasukkan satu kode yang valid. Tanpa pemisahan ini, siapa pun yang menutup
  // halaman di tengah pendaftaran akan terkunci di luar akunnya sendiri.
  totpSecretEnc     String?            @db.Text
  totpEnabledAt     DateTime?
  totpRecoveryCodes TotpRecoveryCode[]

  // ===== Peran karyawan =====
  // Hanya berarti untuk role STAFF. NULL pada STAFF = karyawan tanpa izin sama
  // sekali (masih bisa masuk panel, tapi tidak ada satu halaman pun yang
  // terbuka selain keamanan akunnya sendiri) - keadaan yang disengaja supaya
  // menghapus peran tidak pernah berubah jadi menghapus akses secara diam-diam
  // ke arah yang lebih longgar.
  staffRoleId String?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)

  wallet              Wallet?
  orders              Order[]
  deposits            Deposit[]
  adminActionLogs     AdminActionLog[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  memberships         UserMembership[]
  partnerAccount      PartnerAccount?
  partnerApplications PartnerApplication[]
  resellerAccount     ResellerAccount?
  resellerActivationTokens ResellerActivationToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// Kode pemulihan 2FA — jalan masuk saat aplikasi autentikator hilang.
///
/// WAJIB ADA, bukan pelengkap. Tanpa ini, HP admin yang hilang atau ter-reset
/// berarti panel admin terkunci permanen untuk semua orang, dan satu-satunya
/// jalan keluar adalah mengedit database langsung.
///
/// Yang disimpan HANYA hash SHA-256, pola sama persis dengan PasswordResetToken:
/// kodenya cuma pernah terlihat sekali saat dibuat, jadi bocornya isi tabel ini
/// tidak bisa dipakai masuk. Sekali pakai lewat `usedAt` - kode yang sudah
/// dipakai tidak boleh berlaku lagi walaupun orangnya masih menyimpan kertasnya.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Token reset password (lupa password). Yang disimpan HANYA hash SHA-256 dari token
// mentah — token mentahnya cuma ada di link email, jadi bocornya isi tabel ini tidak
// bisa dipakai untuk mengambil alih akun. Sekali pakai (usedAt) + kedaluwarsa 30 menit.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Token konfirmasi ganti email. Pola penyimpanannya sama persis dengan
// PasswordResetToken di atas (hash SHA-256, sekali pakai, kedaluwarsa 30 menit),
// dengan satu tambahan: `newEmail`.
//
// ===== KENAPA ALAMAT BARU DITITIPKAN DI SINI, BUKAN LANGSUNG DITULIS =====
//
// Email adalah identitas login DAN alamat tujuan link reset password. Kalau
// alamat baru ditulis langsung ke User begitu form disubmit, satu salah ketik
// mengunci orangnya di luar akun sendiri SELAMANYA: dia tidak bisa login (email
// yang benar sudah bukan miliknya lagi) dan tidak bisa memulihkan lewat lupa
// password (link-nya dikirim ke alamat yang tidak pernah dia punya). Untuk akun
// admin - yang memegang kunci pembayaran, kredensial provider, dan seluruh data
// order - itu kehilangan yang tidak ada jalan pulangnya kecuali mengedit
// database langsung.
//
// Dengan alamatnya menunggu di sini sampai link di inbox BARU diklik, salah
// ketik tidak menghasilkan apa pun: link-nya nyasar ke alamat yang tidak ada,
// token kedaluwarsa sendiri dalam 30 menit, dan `User.email` tidak pernah
// tersentuh.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Alamat tujuan. TIDAK @unique: dua orang boleh sama-sama punya permintaan
  // menunggu ke alamat yang sama - yang menentukan siapa yang dapat cuma siapa
  // yang benar-benar bisa membuka inbox itu dan mengklik link-nya duluan.
  // Tabrakannya ditangani @unique milik User.email saat token ditukar.
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Wallet {
  id      String         @id @default(cuid())
  userId  String         @unique
  user    User           @relation(fields: [userId], references: [id])
  balance BigInt         @default(0)
  ledger  WalletLedger[]
}

model WalletLedger {
  id             String     @id @default(cuid())
  walletId       String
  wallet         Wallet     @relation(fields: [walletId], references: [id])
  type           LedgerType
  amount         BigInt // signed: +masuk / -keluar
  balanceAfter   BigInt
  referenceType  String // "order" | "deposit" | "manual" | "membership"
  referenceId    String
  idempotencyKey String     @unique
  note           String?
  createdAt      DateTime   @default(now())

  @@index([walletId, createdAt])
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        BigInt
  fee           BigInt        @default(0)
  uniqueCode    Int           @default(0)
  totalPaid     BigInt        @default(0)
  // Bonus saldo dari benefit tier "deposit_bonus" (lib/membership/benefits.ts).
  // DIHITUNG & DISNAPSHOT saat deposit dibuat (bukan dibaca ulang saat
  // settlement) - kalau tier user berubah atau benefit dimatikan admin di
  // antara deposit dibuat dan dibayar, jumlah yang dijanjikan ke customer saat
  // itu tetap yang dikreditkan. Dikreditkan BERSAMA `amount` dalam satu baris
  // WalletLedger saat settlement (lihat lib/payment/settlement.ts) - bukan
  // ledger terpisah, supaya balance tetap gampang direkonsiliasi.
  bonusAmount   BigInt        @default(0)
  paymentMethod String?
  status        DepositStatus @default(PENDING)
  paymentRef    String?
  rawResponse   Json?
  expiredAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Paket tier member (bronze/silver/gold/platinum secara default, tapi nama,
// harga, durasi, diskon, dan benefit SEPENUHNYA bebas diedit admin - tidak ada
// yang hardcode di kode). Menggantikan konsep lama "login = otomatis dapat
// memberPrice": diskon sekarang HANYA didapat lewat tier aktif yang dibeli.
// ProductItem.memberPrice yang lama dipertahankan bukan sebagai harga member
// otomatis lagi, melainkan LANTAI harga (floor) - diskon tier setinggi apa pun
// tidak akan pernah membuat harga jatuh di bawah angka itu, jadi margin selalu
// terlindungi biar admin tidak perlu menghitung ulang floor per tier per item.
model MembershipTier {
  id                  String           @id @default(cuid())
  name                String
  // Referensi stabil untuk badge/warna/kode - TIDAK berubah walau admin ganti
  // `name` tampilan (mis. "Gold" -> "Gold Member" tidak memutus badge lama).
  slug                String           @unique
  // Harga beli/perpanjang paket tier ini.
  price               BigInt
  durationDays        Int
  // Basis point (100 = 1.00%), pola sama dengan PaymentMethodConfig.feePercent
  // - potongan harga produk untuk pemegang tier ini, diterapkan di atas
  // sellingPrice lalu dilantai memberPrice (lihat lib/pricing/effective-price.ts).
  discountPercent     Int              @default(0)
  // Basis point bonus saldo tambahan tiap deposit - HANYA berlaku kalau
  // benefit "deposit_bonus" ada di `benefits` (dua kontrol terpisah sengaja:
  // admin bisa set angkanya dulu, baru menyalakan/mematikan tanpa reset angka).
  depositBonusPercent Int              @default(0)
  // Daftar key benefit yang dicentang admin - lihat katalog lengkap & artinya
  // masing-masing di lib/membership/benefits.ts. Disimpan sebagai JSON array
  // string (pola sama dengan Product.inputFields), BUKAN tabel/enum terpisah,
  // karena katalog benefit didefinisikan di kode (bukan admin-defined) dan
  // jumlahnya kecil - satu tabel join di sini cuma menambah kerumitan tanpa
  // manfaat nyata.
  resellerAccounts    ResellerAccount[]
  tierPurchases       TierPurchase[]   @relation("TierPurchaseTarget")
  benefits            Json
  // Warna badge tier di UI publik & panel admin (hex). Kosmetik, tapi
  // membedakan tier secara visual sekilas pandang tanpa baca teks.
  badgeColor          String           @default("#a3a3a3")
  isActive            Boolean          @default(true)
  sortOrder           Int              @default(0)
  memberships         UserMembership[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// Satu baris = satu periode kepemilikan tier yang berkelanjutan. Riwayat
// (bukan cuma "tier aktif sekarang") sengaja dipertahankan - kalau nanti
// dibutuhkan laporan "berapa lama user X jadi Gold member", datanya sudah ada
// tanpa perlu migrasi ulang.
//
// Tier aktif seorang user = baris dengan expiresAt > now() yang paling baru
// (lihat lib/membership/tier.ts, getMembershipContext). Beli tier YANG SAMA
// selagi masih aktif memperpanjang expiresAt baris ini (bukan bikin baris
// baru), supaya histori tidak terfragmentasi jadi banyak baris pendek untuk
// satu langganan yang sama. Beli tier BEDA membuat baris baru mulai sekarang -
// sisa waktu tier lama tidak dikembalikan/dikonversi (perilaku "upgrade
// mengganti", bukan akumulasi, supaya tidak perlu logika proration).
/// Keanggotaan program reseller. SATU baris per user.
///
/// ===== KENAPA STATUS DAN TIER DIPISAH =====
///
/// "Reseller" dan "punya diskon" adalah dua hal berbeda. Pendaftar yang baru
/// aktivasi berstatus reseller dengan `tierId` NULL — dan itu berarti harga
/// NORMAL, persis seperti pembeli biasa. Diskon baru menyala setelah dia
/// membeli paket.
///
/// Konsekuensinya menyenangkan: "tier gratis" tidak perlu diwujudkan sebagai
/// baris tier atau baris keanggotaan apa pun. Tidak ada tier aktif = tidak ada
/// diskon = harga normal, yang memang sudah jadi perilaku bawaan seluruh kode
/// harga. Nol baris kode harga yang perlu diubah.
///
/// ⚠️ JANGAN mewujudkan tier gratis sebagai UserMembership berumur panjang.
/// Aturan pemilihan tier dulu memakai `expiresAt` terjauh, jadi baris "gratis"
/// yang berumur panjang akan MENGALAHKAN tier berbayar — diskonnya hilang tanpa
/// satu pun error.
model ResellerAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String
  phone        String
  /// Kode referral yang diketik pendaftar. Disimpan MENTAH: nol validasi, nol
  /// efek, sengaja. Program referralnya belum ada, dan membuang isian ini
  /// sekarang berarti data pendaftar paling awal hilang saat programnya jadi.
  referralCode String?

  /// Paket berbayar saat ini. NULL = paket gratis (harga normal).
  tierId String?
  tier   MembershipTier? @relation(fields: [tierId], references: [id])
  /// Jumlah yang BENAR-BENAR dibayar untuk `tierId` sekarang.
  ///
  /// Inilah dasar kredit saat upgrade, BUKAN harga tier itu hari ini. Kalau
  /// dasarnya harga saat ini, menurunkan harga sebuah paket akan menghukum
  /// orang yang sudah terlanjur membayar penuh: kreditnya ikut turun padahal
  /// uang yang masuk ke kita tidak pernah berkurang.
  tierPricePaid BigInt @default(0)

  /// Dicabut admin. Reseller nonaktif kehilangan diskonnya seketika.
  isActive Boolean @default(true)
  /// NULL = link aktivasi di email belum pernah diklik. Sebelum ini terisi,
  /// akunnya belum berstatus reseller dan belum bisa membeli paket.
  activatedAt DateTime?

  purchases TierPurchase[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tierId])
}

/// Link aktivasi pendaftaran reseller.
///
/// Pola sama persis dengan PasswordResetToken & EmailChangeToken: yang disimpan
/// hanya hash SHA-256, sekali pakai lewat `usedAt`, dan kedaluwarsa sendiri.
/// Bocornya isi tabel ini tidak bisa dipakai mengaktifkan akun siapa pun.
model ResellerActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum TierPurchaseStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

/// Satu kali pembelian/upgrade paket reseller lewat Midtrans.
///
/// Berdiri sendiri (bukan menumpang Deposit) karena uangnya TIDAK pernah masuk
/// saldo: ini pembelian langsung. Menumpang Deposit akan berarti saldo bertambah
/// lalu dipotong lagi, dan tiap kegagalan di tengah meninggalkan saldo yang
/// tidak seharusnya ada.
///
/// Seluruh angkanya DISNAPSHOT saat dibuat, bukan dihitung ulang saat dibayar.
/// Harga paket bisa berubah antara pembeli menekan tombol dan menyelesaikan
/// pembayaran; yang berlaku adalah yang tertera saat dia setuju.
model TierPurchase {
  id         String          @id @default(cuid())
  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  tierId String
  tier   MembershipTier @relation("TierPurchaseTarget", fields: [tierId], references: [id])
  /// Paket yang dimiliki saat membeli. NULL = naik dari paket gratis.
  fromTierId String?

  /// Harga paket tujuan saat pembelian dibuat.
  tierPrice BigInt
  /// Kredit dari paket lama (= `tierPricePaid` saat itu). Dijepit agar tidak
  /// pernah melebihi `tierPrice` — tidak ada tagihan minus, tidak ada refund.
  creditApplied BigInt @default(0)
  fee           BigInt @default(0)
  uniqueCode    Int    @default(0)
  /// Yang benar-benar ditagihkan: tierPrice - creditApplied + fee + uniqueCode.
  totalPaid     BigInt

  paymentMethod String?
  status        TierPurchaseStatus @default(PENDING)
  paymentRef    String?
  rawResponse   Json?
  expiredAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([resellerId, status])
}

model UserMembership {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  tierId               String
  tier                 MembershipTier @relation(fields: [tierId], references: [id])
  startedAt            DateTime       @default(now())
  expiresAt            DateTime
  // Snapshot nominal yang dibayar (0 untuk grant manual admin) - AdminActionLog
  // sudah mencatat siapa admin yang melakukan grant, jadi tidak perlu FK
  // terpisah ke admin di sini.
  pricePaid            BigInt
  // Snapshot durationDays milik tier SAAT dibeli - kalau admin mengubah
  // durationDays tier belakangan, member yang sudah beli tidak ikut
  // berubah retroaktif (pola sama dengan Order menyimpan snapshot
  // sellingPrice/productName, bukan membaca ulang harga produk saat ini).
  durationDaysSnapshot Int
  source               String // "purchase" | "manual_grant"
  createdAt            DateTime       @default(now())

  @@index([userId, expiresAt])
}

// ===== Blok 1: Katalog =====

// Cara harga jual ikut bergerak saat harga modal provider berubah. Penjelasan
// lengkap beserta alasan tiap penjaganya ada di lib/catalog/auto-margin.ts.
enum AutoMarginMode {
  OFF
  FOLLOW_DELTA // harga jual bergeser sebesar pergeseran modal; margin tiap item dipertahankan
  FORMULA // harga jual selalu = modal x (1 + margin); seluruh kategori diseragamkan
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  vouchers  Voucher[] @relation("VoucherCategories")

  // ===== Margin otomatis =====
  // Disetel PER KATEGORI, bukan global, karena karakternya memang berbeda:
  // pulsa marginnya tipis dan sering disetel tangan (cocok FOLLOW_DELTA),
  // voucher game lebih enak diseragamkan (cocok FORMULA).
  //
  // Bawaannya OFF supaya migrasi ini NOL perubahan perilaku saat deploy - tidak
  // ada satu pun harga yang bergerak sampai admin sengaja menyalakannya per
  // kategori. Pola yang sama dipakai Product.partnerVisible.
  autoMarginMode      AutoMarginMode @default(OFF)
  /// Margin untuk mode FORMULA, dalam basis poin (1% = 100). Tidak dipakai mode lain.
  autoMarginBp        Int            @default(800)
  /// Kelipatan pembulatan KE ATAS. 0 = tanpa pembulatan.
  autoMarginRound     Int            @default(100)
  /// Batas perubahan modal yang dianggap wajar (basis poin). Di atas ini harga ditahan.
  autoMarginMaxJumpBp Int            @default(5000)
}

/// Jejak tiap perubahan harga jual yang TIDAK diketik manusia.
///
/// Sebelum ini tidak ada riwayat harga sama sekali di seluruh sistem. Begitu harga
/// bisa berubah sendiri saat sync, ketiadaan jejak berubah dari kekurangan jadi
/// bahaya: harga bergeser, tidak ada yang tahu kapan, oleh aturan mana, dan dari
/// angka berapa - dan pertanyaan itu baru muncul justru saat ada yang salah.
///
/// `productItemId` SENGAJA tanpa relasi Prisma, pola yang sama dengan
/// Order.productItemId: riwayat harus tetap terbaca setelah produknya dihapus,
/// dan relasi Restrict akan membuat penghapusan produk gagal karena jejaknya.
/// Nama produk & item ikut disnapshot supaya barisnya tetap bermakna sendiri.
model PriceChangeLog {
  id            String   @id @default(cuid())
  productItemId String
  productName   String
  itemName      String
  oldSelling    BigInt
  newSelling    BigInt
  oldCost       BigInt
  newCost       BigInt
  /// "auto-margin" - satu-satunya sumber saat ini; kolomnya ada supaya sumber lain menyusul tanpa migrasi.
  source        String
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([productItemId])
}

model Product {
  id               String             @id @default(cuid())
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  slug             String             @unique
  name             String
  publisher        String?
  iconUrl          String? // gambar persegi (1:1) - kartu katalog, trending, ikon halaman produk
  banner           String? // gambar lebar (21:9) - hero halaman produk
  description      String?            @db.Text
  isActive         Boolean            @default(false)
  isTrending       Boolean            @default(false)
  inputFields      Json // contoh ML: [{"name":"user_id","label":"User ID"},{"name":"zone_id","label":"Zone ID"}]
  // Kode game yang disubstitusikan ke placeholder {game} pada URL template cek
  // ID (lihat lib/catalog/id-check.ts). Nilainya ditentukan oleh penyedia API
  // yang dipakai admin, bukan oleh kita - mis. "mobile-legends" / "ml" / "8".
  //
  // Kolom ini sudah ada sejak awal tapi TIDAK pernah dibaca kode mana pun;
  // sekarang dipakai sebagaimana namanya menjanjikan.
  nicknameCheckKey String?
  // Dua kontrol terpisah dengan sengaja (pola sama dengan
  // MembershipTier.depositBonusPercent + benefit "deposit_bonus"): admin bisa
  // mengisi kode game dan mengetesnya lebih dulu, baru menyalakannya untuk
  // pembeli - dan bisa mematikannya saat API penyedia sedang bermasalah tanpa
  // kehilangan konfigurasi yang sudah benar.
  idCheckEnabled   Boolean            @default(false)
  // Cara produk ini dipenuhi. MANUAL dipakai produk yang dikirim admin sendiri
  // (App Premium dsb) - lihat enum FulfillmentMode.
  fulfillmentMode  FulfillmentMode    @default(AUTO)
  // Boleh dijual ke mitra H2H lewat /api/v1/*? Terpisah dari isActive dengan
  // sengaja: keduanya menjawab pertanyaan yang berbeda - isActive = "tayang di
  // storefront untuk pembeli akhir", partnerVisible = "boleh ditarik reseller".
  // Produk yang marginnya tipis, stoknya terbatas, atau eksklusif storefront
  // bisa dimatikan di sini tanpa menghilang dari toko.
  //
  // Default `true` supaya migrasi ini NOL perubahan perilaku saat deploy -
  // seluruh produk yang sekarang muncul di price list partner tetap muncul.
  // Pola yang sama dipakai PaymentMethodConfig.expiryMinutes.
  partnerVisible   Boolean            @default(true)
  items            ProductItem[]
  itemGroups       ProductItemGroup[]
  vouchers         Voucher[]          @relation("VoucherProducts")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Banner {
  id              String   @id @default(cuid())
  // Gambar versi MOBILE (21:9). Tetap bernama `imageUrl` (bukan diganti jadi
  // imageUrlMobile) supaya banner lama tidak perlu dimigrasi datanya sama
  // sekali - kolom ini artinya tidak berubah, cuma dapat pasangan baru.
  imageUrl        String
  // Gambar versi DESKTOP (32:9). Nullable & opsional: kalau kosong, carousel
  // jatuh balik memakai `imageUrl` (perilaku lama - gambar 21:9 dipotong
  // atas-bawah oleh object-cover). Dua gambar terpisah dipakai karena satu
  // gambar tidak bisa tampil utuh di dua rasio yang beda jauh: 21:9 dipaksa
  // ke 32:9 kehilangan 34% tingginya. Pola ini standarnya disebut
  // "art direction" pada responsive images.
  imageUrlDesktop String?
  linkUrl         String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSetting {
  key   String @id // "logo_url", "logo_type" ("image"|"video"), "trending_mode" ("manual"|"auto")
  value String @db.Text
}

model ProductItem {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  name         String
  // Penjelas singkat per nominal, tampil di bawah nama item pada halaman produk.
  // Terpisah dari Product.description yang menjelaskan produknya secara utuh:
  // yang perlu diberitahu pembeli sering justru melekat pada satu nominal saja
  // ("bonus event", "maksimal 1x per akun", "butuh login ulang").
  description  String?           @db.Text
  // Kode SKU buatan admin untuk produk MANUAL. Tidak dipakai mesin fulfillment
  // mana pun - produk manual memang dikirim admin sendiri - ini murni label
  // supaya barang yang dikirim tangan tetap punya identitas yang bisa dirujuk
  // saat mencocokkan stok dan menjawab komplain.
  //
  // Sengaja TIDAK @unique: ini catatan admin, dan constraint yang menolak
  // simpan karena kode kembar cuma akan menghalangi pekerjaan tanpa melindungi
  // apa pun.
  manualSkuCode String?
  // Modal (harga beli) untuk produk MANUAL. Produk AUTO tidak memakainya sama
  // sekali - modalnya hidup di ProviderSku.costPrice, per provider, dan diisi
  // sync harga. Dua sumber untuk satu angka akan menyimpang diam-diam, jadi
  // kolom ini HANYA ditampilkan & dibaca untuk produk manual.
  //
  // null = belum diisi, dan itu SAH: barang yang belum dibeli memang belum
  // punya modal pasti. Order dari item tanpa modal masuk laporan laba sebagai
  // "modal belum tercatat" - laporan jujur bilang tidak tahu, bukan diam-diam
  // menganggap modalnya nol dan labanya 100%.
  costPrice    BigInt?
  sellingPrice BigInt
  memberPrice  BigInt
  // Stok tersedia. null = TAK TERBATAS, dan itu bawaannya - jadi migrasi ini
  // nol perubahan perilaku untuk seluruh item yang sudah ada.
  //
  // Ini angka STOK AWAL, bukan sisa. Sisanya DITURUNKAN dari status order
  // (lib/catalog/stock.ts), persis seperti kuota voucher, karena order pindah
  // ke keadaan gagal di delapan tempat berbeda dan counter yang lupa dikembalikan
  // menyusut diam-diam tanpa satu pun error.
  stock        Int?
  // Flash sale opsional per item. Aktif ditentukan dari waktu server saat
  // request (flashStartAt <= now <= flashEndAt), bukan flag manual yang bisa
  // lupa dimatikan. Lihat lib/pricing/effective-price.ts - satu-satunya
  // tempat yang boleh membaca ketiga field ini buat menentukan harga final.
  flashPrice   BigInt?
  flashStartAt DateTime?
  flashEndAt   DateTime?
  groupId      String?
  group        ProductItemGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  providerSkus ProviderSku[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([groupId])
}

// Pengelompokan bebas item dalam satu produk (mis. "Diamond" vs "Membership"
// di produk Mobile Legends). Bentuk grup sepenuhnya ditentukan admin - nama
// bebas, urutan bebas. Item tanpa grup tetap tampil (bagian tanpa judul di
// bawah), dan hapus grup cuma melepas relasinya (onDelete: SetNull di atas),
// tidak pernah menghapus item.
model ProductItemGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  name      String
  sortOrder Int           @default(0)
  items     ProductItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId])
}

model ProviderSku {
  id              String            @id @default(cuid())
  productItemId   String
  productItem     ProductItem       @relation(fields: [productItemId], references: [id])
  provider        ProviderKey
  providerSkuCode String
  costPrice       BigInt
  status          ProviderSkuStatus @default(ACTIVE)
  // Urutan pemilihan provider untuk item ini: angka KECIL dicoba lebih dulu.
  // Ada supaya satu item bisa dipetakan ke beberapa provider sekaligus tanpa
  // salah satunya menimpa yang lain - admin yang menentukan mana yang utama
  // (mis. pulsa/kuota ke OkeConnect, game ke Digiflazz), bukan aturan otomatis.
  // Default sama rata: kalau semua bernilai sama, urutan ditentukan harga modal
  // termurah sebagai pemecah seri yang deterministik (lihat select-provider.ts).
  priority        Int               @default(100)
  lastSyncedAt    DateTime?

  @@unique([productItemId, provider])
  @@index([provider, providerSkuCode])
}

// Cache lokal seluruh price list provider (bukan cuma SKU yang sudah di-mapping
// admin, beda dari ProviderSku) - diisi ulang penuh tiap "Sync Harga"/job cron,
// dipakai sku-picker.tsx buat cari tanpa hit API provider tiap ketikan (rate
// limit provider, mis. Digiflazz rc 83, kena kalau cari SKU langsung ke API live).
model ProviderPriceListCache {
  id          String      @id @default(cuid())
  provider    ProviderKey
  skuCode     String
  productName String
  brand       String
  costPrice   BigInt
  available   Boolean
  syncedAt    DateTime    @default(now())

  @@unique([provider, skuCode])
  @@index([provider, productName])
}

// ===== Blok 2: Order & Fulfillment =====

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique // INV-YYYYMMDD-XXXX
  // Kunci akses invoice & status API. Ini SATU-SATUNYA penjaga /invoice/[token]
  // (tidak ada cek sesi di sana), dan halamannya menampilkan email pembeli,
  // nomor tujuan, nominal, serta instruksi bayar. Jadi token ini kredensial.
  //
  // SENGAJA TANPA @default(cuid()). Dulu memakainya, padahal cuid v1 bukan
  // pembangkit acak kriptografis - blok acaknya berasal dari Math.random(), yang
  // keadaannya bisa dipulihkan dari beberapa keluaran yang teramati (dan penyerang
  // bisa memperoleh keluaran itu secara sah dengan membuat order sendiri).
  //
  // Tanpa default, TypeScript MEMAKSA setiap titik pembuatan Order mengisi kolom
  // ini - jadi corong pembuatan order berikutnya tidak bisa diam-diam kembali ke
  // pembangkit yang lemah. Isi selalu dengan generatePublicToken()
  // (lib/order/public-token.ts). Aman dihapus tanpa migrasi: default ini hanya
  // ada di level Prisma Client, kolomnya di DB tidak pernah punya DEFAULT.
  publicToken       String               @unique
  status            OrderStatus          @default(PENDING_PAYMENT)
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  productItemId     String?
  productName       String // snapshot
  itemName          String // snapshot
  target            Json // {"user_id":"123","zone_id":"1234"} atau {"phone_number":"08..."}
  buyerEmail        String?
  buyerPhone        String?
  paidVia           PaidVia?
  sellingPrice      BigInt
  total             BigInt
  fee               BigInt               @default(0)
  uniqueCode        Int                  @default(0)
  // SNAPSHOT modal order ini - SATU-SATUNYA kolom yang boleh dibaca laporan
  // laba. Diisi dari dua arah, sekali saja:
  //   - MANUAL: saat checkout, dari ProductItem.costPrice (ikut null kalau
  //     admin belum mengisi modalnya).
  //   - AUTO:   saat percobaan fulfillment BERHASIL, dari costPrice attempt itu
  //     (lib/order/fulfillment.ts). Bukan saat checkout, karena failover bisa
  //     mengirim lewat provider lain dengan modal berbeda - yang benar adalah
  //     modal provider yang BENAR-BENAR memproses, bukan yang dicoba pertama.
  // null = modal tidak tercatat (order lama sebelum kolom ini ada, item manual
  // tanpa modal, atau order yang belum/gagal terkirim). Laporan menghitungnya
  // terpisah sebagai "belum tercatat", tidak pernah dianggap nol.
  costPrice         BigInt?
  paymentMethod     String?
  expiredAt         DateTime?
  completedAt       DateTime?
  manualSn          String?              @db.Text // SN/kode voucher diisi admin lewat "Tandai Selesai Manual" - dipakai invoice kalau tidak ada OrderFulfillment SUCCESS
  // SNAPSHOT Product.fulfillmentMode saat order dibuat (pola sama dengan
  // productName/sellingPrice di atas). Dibaca ulang dari produk akan salah:
  // kalau admin mengubah sebuah produk dari MANUAL ke AUTO, order lama yang
  // belum tuntas mendadak akan dicoba dikirim ke provider yang tidak punya
  // SKU-nya, dan sebaliknya order AUTO yang sudah terkirim akan terlihat
  // seperti masih menunggu dikirim admin.
  fulfillmentMode   FulfillmentMode      @default(AUTO)
  // ===== Jalur API Partner (H2H) =====
  // Terisi HANYA untuk order yang masuk lewat POST /api/v1/transaction. Order
  // storefront biasa selalu null di kedua kolom.
  //
  // partnerRefId = nomor referensi milik SISTEM PARTNER (bukan kita). Dipasangkan
  // dengan @@unique di bawah, kolom ini adalah SATU-SATUNYA penjamin idempotensi
  // API partner: partner yang mengirim ulang ref_id yang sama (timeout jaringan,
  // retry otomatis di sisi mereka) akan menabrak unique constraint alih-alih
  // membuat order kedua dan mendebit saldonya dua kali. Jangan pernah menghapus
  // constraint itu "biar partner bisa order ulang" - itu lubang double-charge.
  partnerId         String?
  partner           PartnerAccount?      @relation(fields: [partnerId], references: [id])
  partnerRefId      String?
  // ===== Voucher =====
  // `discount` adalah potongan yang SUDAH ikut diperhitungkan di `total`
  // (total = sellingPrice - discount + fee + uniqueCode). Disimpan terpisah,
  // bukan cuma memotong sellingPrice, karena sellingPrice adalah SNAPSHOT harga
  // item saat order dibuat - laporan penjualan & cek margin membacanya sebagai
  // harga jual yang sebenarnya berlaku, dan mengurangkannya diam-diam akan
  // membuat setiap order bervoucher terlihat seperti item yang harganya lebih
  // murah, bukan seperti penjualan normal yang diberi potongan.
  //
  // `voucherCode` disnapshot (bukan cuma lewat relasi) supaya invoice & struk
  // lama tetap menyebut kodenya walau vouchernya sudah dihapus admin.
  discount          BigInt               @default(0)
  voucherCode       String?
  voucherRedemption VoucherRedemption?
  payment           OrderPayment?
  fulfillments      OrderFulfillment[]
  statusHistory     OrderStatusHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([partnerId, partnerRefId])
  @@index([status, createdAt])
  @@index([publicToken])
  @@index([partnerId, createdAt])
}

model PaymentMethodConfig {
  id            String   @id @default(cuid())
  code          String   @unique // "qris" | "va_bca" | "va_bni" | "va_bri" | "va_mandiri" | "va_permata" | "va_cimb" | "ewallet_gopay" | "ewallet_shopeepay"
  label         String
  logoUrl       String?
  feeFlat       BigInt   @default(0)
  feePercent    Int      @default(0) // basis point: 100 = 1.00%
  // Batas waktu bayar per metode, diatur admin. Angka ini mengalir ke TIGA
  // tempat sekaligus dan harus tetap satu nilai: expiredAt lokal order/deposit,
  // custom_expiry yang dikirim ke Midtrans, dan runAt job expire-order/
  // expire-deposit. Kalau ketiganya sampai berbeda, akan ada jendela waktu di
  // mana customer masih bisa membayar sesuatu yang di sistem kita sudah mati.
  // Divalidasi MIN_EXPIRY_MINUTES..MAX_EXPIRY_MINUTES di lib/payment/rules.ts.
  expiryMinutes Int      @default(15)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderPayment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  method      String // "qris" | "gopay" | "va" | "balance"
  paymentRef  String?
  status      PaymentStatus @default(PENDING)
  actions     Json? // qr_string / deeplink dari Midtrans
  rawResponse Json?
  expiredAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([paymentRef])
}

model OrderFulfillment {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  attemptNo       Int
  provider        ProviderKey
  providerSkuCode String
  costPrice       BigInt // snapshot saat attempt
  ourRefId        String            @unique // dikirim ke provider, kunci pencocokan callback
  providerRef     String?
  status          FulfillmentStatus @default(SENT)
  sn              String? // serial number / token hasil
  message         String?
  rawCallback     Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([orderId, attemptNo])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
}

// ===== Blok 4: Operasional =====

model ProviderConfig {
  id                 String               @id @default(cuid())
  key                ProviderKey          @unique
  displayName        String
  credentials        Json? // terenkripsi di layer aplikasi sebelum simpan
  isActive           Boolean              @default(false)
  priority           Int                  @default(100) // kecil = diprioritaskan saat harga seri
  balance            BigInt               @default(0)
  healthStatus       HealthStatus         @default(UNKNOWN)
  lastHealthCheckAt  DateTime?
  minBalanceAlert    BigInt? // ambang batas alert Telegram - null = alert nonaktif utk provider ini
  balanceAlertStatus BalanceAlertStatus   @default(OK) // state machine edge-triggered, lihat decideBalanceAlertTransition
  balanceLogs        ProviderBalanceLog[]
  updatedAt          DateTime             @updatedAt
}

model ProviderBalanceLog {
  id         String         @id @default(cuid())
  providerId String
  provider   ProviderConfig @relation(fields: [providerId], references: [id])
  balance    BigInt
  createdAt  DateTime       @default(now())
}

model PriceSyncLog {
  id          String      @id @default(cuid())
  provider    ProviderKey
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  skusUpdated Int         @default(0)
  skusMissing Int         @default(0)
  result      String?
  error       String?     @db.Text
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  runAt       DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  status      JobStatus @default(PENDING)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique // contoh: "login:ip:1.2.3.4:1753862400000" (endpoint:tipe:nilai:windowStartMs)
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
}

// ===== Blok 5: Analytics pengunjung =====

// Satu baris = satu kali halaman publik dibuka. Ditulis dari endpoint beacon
// (api/track), BUKAN dari middleware - middleware jalan untuk setiap aset,
// prefetch, dan permintaan bot juga, dan menulis satu baris DB untuk masing-
// masing akan menenggelamkan biaya database jauh sebelum memberi data berguna.
//
// TIDAK menyimpan alamat IP mentah. Yang disimpan `visitorHash`, yaitu SHA-256
// dari (IP + user agent + garam harian) - cukup untuk menghitung pengunjung
// unik per hari, tapi tidak bisa dibalik jadi identitas orang, dan otomatis
// berbeda tiap hari sehingga tidak bisa dipakai melacak seseorang antar-hari.
// Ini juga yang membuatnya sejalan dengan halaman Kebijakan Privasi kita.
//
// Tabel ini SEMENTARA: job cron "rollup-analytics" meringkasnya jadi
// AnalyticsDaily lalu membuang baris yang lebih tua dari retensi. Tanpa itu,
// toko yang ramai akan menumpuk jutaan baris yang tak pernah dibaca lagi.
model PageView {
  id           String   @id @default(cuid())
  path         String   @db.VarChar(255)
  visitorHash  String   @db.VarChar(64)
  sessionId    String   @db.VarChar(64)
  referrerHost String?  @db.VarChar(191)
  device       String   @db.VarChar(16) // "mobile" | "tablet" | "desktop"
  // Diisi kalau pengunjungnya sedang login - memungkinkan corong
  // "kunjungan -> order" dihitung per member, bukan cuma agregat anonim.
  userId       String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([path, createdAt])
}

// Ringkasan harian permanen. Dibuat job rollup dari PageView sebelum baris
// mentahnya dibuang, supaya grafik jangka panjang (bulanan/tahunan) tetap ada
// tanpa menyimpan data mentahnya selamanya.
//
// Rincian (halaman terpopuler, referrer, perangkat) disimpan sebagai Json
// alih-alih tabel anak: isinya selalu dibaca utuh sebagai satu blok untuk satu
// tanggal, tidak pernah di-query per baris, jadi tabel terpisah cuma menambah
// join tanpa manfaat.
model AnalyticsDaily {
  date         DateTime @id @db.Date
  pageviews    Int      @default(0)
  visitors     Int      @default(0)
  sessions     Int      @default(0)
  topPaths     Json
  topReferrers Json
  devices      Json
  computedAt   DateTime @default(now())
}

model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())
}

model WebhookEvent {
  id            String    @id @default(cuid())
  source        String // "midtrans" | "digiflazz" | "okeconnect" | "qiospay" | "serpul"
  externalRef   String?
  eventKey      String?   @unique // idempotency: `${source}:${ref}:${status}`
  rawBody       String    @db.Text
  headers       Json
  processedAt   DateTime?
  processResult String?
  createdAt     DateTime  @default(now())

  @@index([source, externalRef])
}

// Riwayat MENTAH setiap panggilan HTTP KELUAR ke API provider: request yang kita
// kirim, respons apa adanya, status HTTP, durasi, dan error transport.
//
// WebhookEvent di atas hanya mencatat yang MASUK. Untuk arah keluar, satu-satunya
// jejak selama ini adalah OrderFulfillment.message (satu kalimat) + rawCallback -
// dan rawCallback baru terisi kalau respons berhasil di-parse DAN row-nya berhasil
// diklaim. Kalau panggilan timeout, ditolak di lapisan jaringan, atau membalas
// HTML/non-JSON, seluruh datanya hilang dan admin tidak punya apa pun untuk
// dilihat selain order yang gagal tanpa sebab. Tabel ini menyimpan semuanya,
// termasuk panggilan yang TIDAK terikat order (sync harga, cek saldo) yang gagal
// karena sebab sistemik yang sama (IP belum di-whitelist, kredensial salah).
//
// Sengaja TANPA foreign key ke Order/OrderFulfillment: penulisan log tidak boleh
// pernah gagal gara-gara row induknya belum/tidak ada, dan log wajib tetap ada
// walau order-nya dihapus - log forensik yang ikut terhapus bersama objek yang
// sedang diselidiki tidak ada gunanya.
model ProviderApiLog {
  id            String      @id @default(cuid())
  provider      ProviderKey
  operation     String // "transaction" | "check-status" | "price-list" | "cek-saldo"
  endpoint      String
  outcome       String // lihat PROVIDER_API_OUTCOMES di lib/providers/api-log.ts
  httpStatus    Int?
  durationMs    Int
  orderId       String?
  orderNumber   String?
  fulfillmentId String?
  ourRefId      String?
  providerRc    String? // rc mentah dari provider, kalau ada
  message       String?     @db.Text // pesan mentah provider, disalin keluar biar bisa dicari
  // true = keluar lewat relay ber-IP tetap, false = langsung dari runtime ini.
  // Wajib terlihat: kegagalan rc 45 ("IP tidak dikenal") artinya sangat berbeda
  // tergantung jalurnya - lewat relay berarti IP relay yang belum di-whitelist,
  // langsung berarti env relay-nya yang belum terpasang di deployment ini.
  viaRelay      Boolean     @default(false)
  requestBody   Json // kredensial SUDAH diredaksi sebelum disimpan
  responseBody  Json?
  responseText  String?     @db.Text // diisi hanya kalau respons BUKAN JSON
  errorMessage  String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([orderId])
  @@index([ourRefId])
  @@index([provider, outcome, createdAt])
}

// ===== Blok 9: API Partner (H2H reseller) =====

// Kredensial & konfigurasi satu partner reseller yang memesan lewat
// POST /api/v1/* (lihat web/src/content/api-partner.md).
//
// SENGAJA menempel pada User yang sudah ada, BUKAN tabel akun terpisah. Alasannya
// bukan sekadar hemat kolom: partner membayar dari SALDO PRABAYAR, dan seluruh
// mesin saldo yang sudah teruji - Wallet, WalletLedger (double-entry + idempotencyKey),
// debit atomik `updateMany(balance: { gte: total })` di checkout, auto-refund ke saldo
// saat fulfillment gagal, halaman /admin/wallet-ledger - semuanya sudah berbasis
// userId. Membuat "saldo partner" tersendiri berarti menulis ulang semua itu di
// jalur uang kedua yang tidak pernah dites sekeras yang pertama. Efek sampingnya
// juga menguntungkan: partner bisa isi saldo lewat /account/deposit yang sudah ada
// (QRIS/VA), tanpa satu baris kode top-up baru.
model PartnerAccount {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id])
  // Identitas yang dikirim partner di body request. Terpisah dari email login
  // supaya kredensial API bisa dicabut/diganti tanpa menyentuh akun loginnya.
  username          String              @unique
  // API key DIENKRIPSI (AES-256-GCM lewat lib/crypto.ts), BUKAN di-hash.
  //
  // Ini keputusan yang perlu dibaca sebelum "diperbaiki": skema tanda tangan
  // md5(username + apiKey + ref_id) mengharuskan server menghitung ulang hash
  // yang sama, jadi kita WAJIB bisa membaca kembali apiKey aslinya - hash satu
  // arah (bcrypt/SHA) mustahil dipakai di sini. Ini persis situasi & pola yang
  // sama dengan kredensial Digiflazz di ProviderConfig.credentials.
  apiKeyEnc         String              @db.Text
  // URL callback partner. Kosong = partner memilih polling status sendiri.
  callbackUrl       String?             @db.Text
  // Secret HMAC-SHA256 untuk menandatangani body callback KELUAR, supaya partner
  // bisa membuktikan callback benar-benar dari kita. Terenkripsi, alasan sama
  // seperti apiKeyEnc (kita harus bisa membacanya untuk menandatangani).
  callbackSecretEnc String?             @db.Text
  // Daftar IP yang boleh memanggil, dipisah koma. NULL/kosong = semua IP boleh.
  // Sengaja opsional: partner di shared hosting punya IP tetap dan sebaiknya
  // mengunci, tapi partner di cloud (IP berganti-ganti) akan terkunci keluar
  // permanen kalau kolom ini wajib - persis masalah rc 45 Digiflazz yang sudah
  // kita alami sendiri dari sisi sebaliknya (lihat docs/08-IP-TETAP-DIGIFLAZZ.md).
  ipWhitelist       String?             @db.Text
  isActive          Boolean             @default(true)
  // Jejak pemakaian terakhir - dipakai admin untuk melihat partner yang tidak
  // pernah benar-benar mengintegrasikan, tanpa harus menggali tabel Order.
  lastUsedAt        DateTime?
  orders            Order[]
  // Pengajuan yang melahirkan akun ini. NULL untuk partner yang dibuat admin
  // langsung lewat /admin/partners (jalur lama, tetap dipertahankan untuk
  // kasus darurat/demo).
  applicationId     String?             @unique
  application       PartnerApplication? @relation(fields: [applicationId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Bentuk badan usaha pemohon. Daftarnya mengikuti form pendaftaran H2H yang
// sudah jadi standar di industri ini (Perorangan vs Badan Hukum), dipecah
// sedikit lebih halus supaya admin bisa membedakan CV/PT tanpa membuka lampiran.
enum PartnerBusinessType {
  PERORANGAN
  CV
  PT
  KOPERASI
  LAINNYA
}

/// Pengajuan bergabung jadi mitra H2H.
///
/// Kemitraan di sini SENGAJA tidak terbuka untuk publik: formnya hanya bisa
/// diakses dari dalam panel user (/account/mitra), jadi pemohon wajib sudah
/// jadi member DannShop yang emailnya terverifikasi lewat alur register biasa.
/// Itu memberi kita identitas awal gratis dan mencegah price list - yang pada
/// dasarnya adalah struktur harga dan margin kita - ditarik oleh orang yang
/// belum pernah kita kenal sama sekali.
///
/// Kolom teknis (serverIps/callbackUrl/platform) dikumpulkan DI SINI, bukan
/// ditanyakan lagi setelah disetujui, karena nilainya langsung disalin ke
/// PartnerAccount saat approve. Field "IP Center" adalah pola yang dipakai
/// distributor H2H besar dan alasannya sama dengan yang sudah kita alami dari
/// sisi sebaliknya: partner yang lupa mendaftarkan IP akan tertahan rc 12 di
/// panggilan pertamanya, dan itu momen terburuk untuk menemukan masalah.
model PartnerApplication {
  id     String                   @id @default(cuid())
  userId String
  user   User                     @relation(fields: [userId], references: [id])
  status PartnerApplicationStatus @default(PENDING)

  // ===== Data usaha =====
  businessName String
  businessType PartnerBusinessType @default(PERORANGAN)
  businessCity String
  websiteUrl   String?             @db.Text

  // ===== PIC (penanggung jawab) =====
  // Nomor WhatsApp wajib: kalau integrasi partner mengamuk (retry tanpa henti,
  // saldo habis di tengah malam), email tidak cukup cepat.
  picName  String
  picPhone String
  picRole  String?

  // ===== Data teknis =====
  // Software/platform yang dipakai partner. Menentukan seberapa banyak bantuan
  // integrasi yang perlu disiapkan - "sistem sendiri" beda jauh dari "aplikasi
  // H2H pihak ketiga" yang formatnya sudah dipatok vendor mereka.
  platform    String?
  // Calon isi PartnerAccount.ipWhitelist. Dipisah koma, sama persis formatnya.
  serverIps   String? @db.Text
  callbackUrl String? @db.Text

  // ===== Skala & motivasi =====
  // Disimpan sebagai String (bukan enum) supaya rentangnya bisa diubah kapan
  // saja tanpa migrasi; daftar nilainya dikunci zod di lib/partner/application.ts.
  monthlyVolume String
  notes         String? @db.Text

  // ===== Tinjauan admin =====
  reviewedById String?
  reviewedAt   DateTime?
  // Alasan penolakan. DITAMPILKAN ke pemohon, jadi isinya harus layak dibaca
  // orang luar - bukan catatan internal.
  reviewNote   String?   @db.Text

  partnerAccount PartnerAccount?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ===== Kode promo / voucher =====

enum VoucherDiscountType {
  PERCENT // potongan persentase dari harga item, boleh dibatasi maxDiscount
  FIXED // potongan nominal tetap
}

model Voucher {
  id          String  @id @default(cuid())
  /// SELALU disimpan huruf besar. Pembeli mengetiknya bebas; penyeragaman ada
  /// di lib/voucher/code.ts supaya "hemat10" dan "HEMAT10" adalah kode yang sama.
  code        String  @unique
  /// Catatan internal admin. TIDAK pernah ditampilkan ke pembeli.
  description String? @db.Text

  discountType VoucherDiscountType
  /// Mode PERCENT: potongan dalam basis poin (1000 = 10,00%). Tidak dipakai mode FIXED.
  percentBp    Int                 @default(0)
  /// Mode FIXED: nominal potongan. Mode PERCENT: BATAS ATAS potongan, 0 = tanpa batas.
  amount       BigInt              @default(0)
  /// Harga item minimal supaya voucher berlaku. 0 = tanpa minimum.
  minSpend     BigInt              @default(0)

  /// Kuota pemakaian total. 0 = tak terbatas.
  quota          Int @default(0)
  /// Maksimal pemakaian untuk SATU nomor tujuan yang sama. 0 = tak terbatas.
  ///
  /// Dikunci ke nomor tujuan (nomor HP / User ID + Zone ID), BUKAN ke email atau
  /// akun pembeli. Alasannya: pembeli tanpa akun boleh ikut memakai voucher, dan
  /// email baru gratis dibuat sebanyak-banyaknya - sementara akun game atau nomor
  /// HP tujuan adalah hal yang benar-benar dimiliki orangnya. Lihat
  /// lib/voucher/target-key.ts.
  perTargetLimit Int @default(1)

  startAt  DateTime?
  endAt    DateTime?
  isActive Boolean   @default(true)

  /// Boleh dipakai pada item yang SEDANG flash sale. Bawaannya false: flash sale
  /// sudah memotong harga sekali, dan menumpuknya dengan voucher bisa menembus
  /// harga modal tanpa ada yang menyadarinya sampai laporan bulanan.
  allowFlashSale Boolean @default(false)
  /// Boleh dipakai pembeli tanpa akun.
  allowGuest     Boolean @default(true)

  /// Pembatas cakupan. KOSONG BERARTI BERLAKU UNTUK SEMUA - bukan "tidak berlaku
  /// untuk apa pun". Dipisah dua relasi (bukan satu kolom polimorfik) supaya
  /// integritasnya dijaga foreign key, dan produk/kategori yang dihapus
  /// otomatis lepas dari vouchernya.
  categories Category[] @relation("VoucherCategories")
  products   Product[]  @relation("VoucherProducts")

  redemptions VoucherRedemption[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, endAt])
}

/// Satu baris per pemakaian voucher pada sebuah order.
///
/// SENGAJA TIDAK ADA kolom penghitung "sudah terpakai berapa" yang harus
/// dikurangi lagi saat order gagal. Pemakaian yang masih sah DITURUNKAN dari
/// status ordernya (lihat lib/voucher/usage.ts): order yang FAILED, EXPIRED,
/// atau REFUNDED berhenti dihitung dengan sendirinya.
///
/// Itu keputusan struktural, bukan selera. Status order berpindah ke keadaan
/// gagal di ENAM tempat berbeda (job auto-expire, dua cabang webhook settlement,
/// dua jalur refund fulfillment, dan refund manual admin). Penghitung yang harus
/// dikurangi menuntut keenamnya ingat memanggil pelepasan - dan yang terlupa
/// tidak menimbulkan error apa pun, cuma kuota voucher yang menyusut diam-diam
/// sampai kodenya berhenti bisa dipakai tanpa sebab yang terlihat.
model VoucherRedemption {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  /// @@unique: satu order tidak akan pernah memakai lebih dari satu voucher,
  /// dan pengiriman ulang form checkout tidak bisa mengklaim kuota dua kali.
  orderId   String  @unique
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Sidik jari nomor tujuan, sudah dinormalkan. Inilah penjaga anti-abuse utama.
  targetKey String
  /// Terisi hanya kalau pembelinya login. Untuk penelusuran, BUKAN untuk batas
  /// pemakaian - batasnya dihitung dari targetKey.
  userId    String?
  /// Potongan yang benar-benar diberikan, disnapshot. Aturan voucher bisa diubah
  /// admin kapan saja; laporan harus tetap menyebut angka yang dulu dipakai.
  amount    BigInt

  createdAt DateTime @default(now())

  @@index([voucherId, targetKey])
  @@index([voucherId, createdAt])
}
